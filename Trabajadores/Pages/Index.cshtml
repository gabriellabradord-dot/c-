@page
@model Trabajadores.Pages.IndexModel
@{
    ViewData["Title"] = "Cálculo de Salarios";
}

<div class="container mt-5">
    <h2>Cálculo de Salario Semanal de Obreros</h2>
    
    <form method="post" class="mt-4">
        <div class="mb-3">
            <label for="Txtcantidad" class="form-label">Cantidad de obreros:</label>
            <input type="number" id="Txtcantidad" name="Txtcantidad" class="form-control" value="@Model.Txtcantidad" required />
        </div>

        <div class="mb-3">
            <label for="Txtht" class="form-label">Horas trabajadas :</label>
            <input type="text" id="Txtht" name="Txtht" class="form-control" value="@Model.Txtht" placeholder="" required />
        </div>

        <button type="submit" class="btn btn-primary">Calcular Salarios</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.Resultado))
    {
        <div class="mt-4 alert alert-info">
            <h4>Resultado:</h4>
            <div>@Html.Raw(Model.Resultado)</div>
        </div>
    }
</div>