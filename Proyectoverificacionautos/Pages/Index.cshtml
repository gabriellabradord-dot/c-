@page
@model Proyectoverificacionautos.Pages.IndexModel
@{
    ViewData["Title"] = "Verificación de Automóviles";
}

<div class="container mt-5">
    <h2>Centro de Verificación de Automóviles</h2>
    <p class="text-muted">Ingresa los puntos contaminantes de los automóviles (hasta 25)[cite: 3].</p>

    <form method="post" class="mt-4">
        <div class="mb-3">
            <label class="form-label"><strong>Puntos contaminantes (separados por comas o espacios):</strong></label>
            <textarea asp-for="PuntosTexto" class="form-control" rows="3" placeholder=""></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Analizar Contaminación</button>
    </form>

    @if (Model.HaCalculado)
    {
        <hr class="my-4">
        <h3 class="mb-3">Resultados de la Verificación</h3>
        
        <div class="row">
            <div class="col-md-4">
                <div class="card p-3 bg-light shadow-sm">
                    <h5>Promedio de Puntos</h5>
                    <p class="fs-4 text-primary mb-0"><strong>@Model.PromedioPuntos.ToString("F2")</strong></p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-3 bg-light shadow-sm">
                    <h5>Menor Contaminación</h5>
                    <p class="fs-4 text-success mb-0"><strong>@Model.MenorContaminacion</strong> pts</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card p-3 bg-light shadow-sm">
                    <h5>Mayor Contaminación</h5>
                    <p class="fs-4 text-danger mb-0"><strong>@Model.MayorContaminacion</strong> pts</p>
                </div>
            </div>
        </div>
    }
</div>