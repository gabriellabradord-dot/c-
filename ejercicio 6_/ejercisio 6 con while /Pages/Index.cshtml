@page
@model Trabajadores.Pages.IndexModel
@{
    ViewData["Title"] = "Simulador de Inversión Mensual (While)";
}

<div class="container mt-5" style="max-width: 650px;">
    <div class="card shadow border-0 p-4">
        <h2 class="mb-3 text-primary font-weight-bold">Simulador de Inversión Bancaria</h2>
        <p class="text-muted">
            Calcula cuánto dinero tendrás al cabo de 1 año (12 meses) con una tasa de interés mensual del 2% y reinversión de ganancias.
        </p>

        <form method="post" class="mt-3">
            <div class="mb-4">
                <label for="CapitalInicial" class="form-label font-weight-bold">
                    Capital inicial a invertir ($):
                </label>
                <input type="number" step="any" id="CapitalInicial" name="CapitalInicial" class="form-control form-control-lg" value="@Model.CapitalInicial" placeholder="Ej. 1000" required />
                <div class="form-text text-secondary mt-2">
                     Ingresa la cantidad de dinero con la que deseas abrir tu cuenta. El banco otorga un <b>2% mensual</b> durante 12 meses.
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">Calcular Inversión Anual</button>
        </form>

        @if (!string.IsNullOrEmpty(Model.Resultado))
        {
            <div class="mt-4 alert @(Model.TieneErrores ? "alert-warning" : "alert-success") shadow-sm">
                <h4 class="alert-heading mb-2">Resultado de la Auditoría:</h4>
                <div style="font-size: 1.05rem; max-height: 300px; overflow-y: auto;">@Html.Raw(Model.Resultado)</div>
            </div>
        }
    </div>
</div>