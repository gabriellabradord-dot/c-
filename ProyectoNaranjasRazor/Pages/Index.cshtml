@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container mt-5">
    <h2>Control de Ventas - Expendio de Naranjas</h2>
    <p class="text-muted">Ingresa los kilos comprados por los clientes (hasta 15) y define el precio por kilo.</p>

    <form method="post" class="mt-4">
        <div class="mb-3">
            <label class="form-label"><strong>Kilos por cliente (separados por comas o espacios):</strong></label>
            <textarea asp-for="KilosTexto" class="form-control" rows="3" placeholder="Ej: 12, 8, 15, 5, 22, 10, 11..."></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label"><strong>Precio por Kilo ($):</strong></label>
            <input asp-for="PrecioKilo" class="form-control" type="number" step="100" />
        </div>

        <button type="submit" class="btn btn-success">Calcular Pagos y Total de la Tienda</button>
    </form>

    @if (Model.HaCalculado)
    {
        <hr class="my-4">
        <h3 class="mb-3">Resultados de la Caja</h3>
        
        <div class="alert alert-primary">
            <h4>Total que percibirá la tienda: <strong>$@Model.TotalTienda.ToString("F2")</strong></h4>
        </div>

        <h5 class="mt-4">Detalle de pago por cliente:</h5>
        <ul class="list-group">
            @foreach (var detalle in Model.DetalleClientes)
            {
                <li class="list-group-item">@detalle</li>
            }
        </ul>
    }
</div>