@page
@model Trabajadores.Pages.IndexModel
@{
    ViewData["Title"] = "Control de Peso del Club";
}

<div class="container mt-5" style="max-width: 700px;">
    <div class="card shadow p-4">
        <h2 class="mb-3 text-primary">Control de Peso - Club Contra la Obesidad</h2>
        <p class="text-muted">
            Ingresa el peso anterior de los 5 miembros y sus 10 pesajes correspondientes.
        </p>

        <form method="post" class="mt-3">
            @for (int i = 1; i <= 5; i++)
            {
                <div class="card p-3 mb-3 bg-light">
                    <h5 class="text-secondary">Persona @i</h5>
                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <label class="form-label font-weight-bold">Peso Anterior (kg):</label>
                            <input type="number" step="any" name="PesoAnterior_@i" class="form-control" placeholder="Ej. 85.5" required />
                        </div>
                        <div class="col-md-8 mb-2">
                            <label class="form-label font-weight-bold">10 Pesajes en Básculas:</label>
                            <input type="text" name="Pesajes_@i" class="form-control" placeholder="Ej. 80 81 80.5 81 80 80.5 81 80 80.5 81" required />
                        </div>
                    </div>
                </div>
            }

            <button type="submit" class="btn btn-primary btn-lg w-100 mt-2">Calcular Resultados</button>
        </form>

        @if (!string.IsNullOrEmpty(Model.Resultado))
        {
            <div class="mt-4 alert alert-info">
                <h4>Resultados del Pesaje:</h4>
                <div>@Html.Raw(Model.Resultado)</div>
            </div>
        }
    </div>
</div>